# Auto-detect text files and normalize line endings
* text=auto

# Source files
*.java text eol=lf
*.kt text eol=lf
*.kts text eol=lf
*.xml text eol=lf
*.json text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
*.md text eol=lf
*.properties text eol=lf
*.js text eol=lf
*.ts text eol=lf
*.tsx text eol=lf
*.css text eol=lf
*.scss text eol=lf
*.html text eol=lf
*.sh text eol=lf

# Binary files - never modify line endings
*.modl binary
*.jar binary
*.png binary
*.jpg binary
*.gif binary
*.jks binary
*.der binary
*.p12 binary
*.ico binary
*.zip binary
*.class binary
