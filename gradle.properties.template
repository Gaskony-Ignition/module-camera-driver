# Ignition SDK version
ignition.sdk.version=8.3.0

# Gaskony Module Signing Configuration
# Uses shared keystore for consistent vendor name across all Gaskony modules
ignition.signing.keystoreFile=/path/to/your/gaskony-keystore.jks
ignition.signing.keystorePassword=YOUR_PASSWORD_HERE
ignition.signing.certAlias=gaskony-module
ignition.signing.certPassword=YOUR_PASSWORD_HERE
ignition.signing.certFile=/path/to/your/gaskony-cert.pem

# Gradle daemon settings
org.gradle.daemon=true
org.gradle.jvmargs=-Xmx2048M
